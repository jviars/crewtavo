# Optional settings for a Crewtavo instance. On Railway, add them to the crewtavo service's
# Variables; locally, add them to .env.instance (which `npm run instance` creates with the
# required secrets). Everything a new instance needs is generated, so all of these are optional.
# See docs/deploy.md for what each one turns on.

# Your own domain, once you've added it in Railway (defaults to the *.up.railway.app address).
# APP_URL=https://ops.example.com

# Encrypts app tokens and signs client links. Without it, a key is derived from JWT_SECRET.
# ENCRYPTION_KEY=

# Email for the whole instance (each company can also connect its own mailbox in Settings → Email)
# RESEND_API_KEY=
# EMAIL_FROM=

# Text messages
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Online payments: one Stripe account for every company here. A business usually connects its own
# Stripe on the Apps page instead.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Maps, measuring and roof pitch
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_SERVER_KEY=

# AI
# ANTHROPIC_API_KEY=
# AI_MODEL=

# Accounting and calendar
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bot protection on public booking and referral forms
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Error tracking: a Sentry or self-hosted GlitchTip DSN
# CREWTAVO_SENTRY_DSN=
# CREWTAVO_SENTRY_ENVIRONMENT=
