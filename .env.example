# Optional settings for a Crewtavo instance. On Railway, add them to the crewtavo service's
# Variables; locally, add them to .env.instance (which `npm run instance` creates with the
# required secrets). Everything a new instance needs is generated, so all of these are optional.
# See docs/deploy.md for what each one turns on.

# Your own domain (defaults to the *.up.railway.app address). Settings → Web address sets it on Railway.
# APP_URL=https://ops.example.com

# Encrypts app tokens and signs client links. Without it, a key is derived from JWT_SECRET.
# ENCRYPTION_KEY=

# Only to help an owner who lost their password and their spare keys (docs/deploy.md, "Getting
# back in"): their email and a phrase you make up (12+ characters). Delete both afterwards.
# CREWTAVO_RECOVERY_EMAIL=
# CREWTAVO_RECOVERY_CODE=

# Email for the whole instance (each company can also connect its own mailbox in Settings → Email)
# RESEND_API_KEY=
# EMAIL_FROM=

# Text messages
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Online payments: one Stripe account for every company here. A business usually connects its own
# Stripe on the Apps page instead.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Maps, measuring and roof pitch
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_SERVER_KEY=

# AI
# ANTHROPIC_API_KEY=
# AI_MODEL=

# Accounting and calendar
# QuickBooks and Zoho Books: each business can paste its own app's keys on the Apps page instead.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Import from Google Drive (Drive): a browser API key for the Google Picker API, restricted to your
# domain and https://docs.google.com/*, in GOOGLE_CLIENT_ID's Google Cloud project (docs/deploy.md).
# GOOGLE_PICKER_API_KEY=

# Bot protection on public booking and referral forms
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Where visitors' addresses come from, only when something other than Railway's edge or one web
# server (Caddy, nginx) is in front: x-forwarded-for:2, a header like cf-connecting-ip, or connection.
# CREWTAVO_VISITOR_IP=

# Docker only: the address port 8080 answers on. 127.0.0.1 (the default) is this computer, for a
# web server here to forward to; see docs/deploy.md (Visitors' addresses) before opening it up.
# CREWTAVO_BIND=127.0.0.1

# Error tracking: a Sentry or self-hosted GlitchTip DSN
# CREWTAVO_SENTRY_DSN=
# CREWTAVO_SENTRY_ENVIRONMENT=
